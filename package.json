{
  "name": "rising-roots-root",
  "version": "1.0.0",
  "private": true,
  "description": "Rising Roots Fullstack Application",
  "scripts": {
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "db:view": "npm run db:view --prefix backend"
  }
}
