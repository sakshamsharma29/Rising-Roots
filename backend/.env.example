# Server & Environment
PORT=5000
NODE_ENV=production

# MongoDB Connection String
# For cloud deployment, create a free MongoDB Atlas cluster and paste URI here:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rising_roots?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rising_roots

# JWT Secret for User Sessions
JWT_SECRET=supersecret_risingroots_jwt_key_2026

# Optional: Telegram VIP Signal Bot Token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHANNEL_ID=@your_vip_channel

# Optional: Payment Gateway (Stripe or Crypto)
# STRIPE_SECRET_KEY=sk_live_...
