# Server & Environment
PORT=5000
NODE_ENV=production

# MongoDB Connection String
# For cloud deployment, create a free MongoDB Atlas cluster and paste URI here:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rising_roots?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/rising_roots

# JWT Secret for User Sessions
JWT_SECRET=supersecret_risingroots_jwt_key_2026

# Dedicated Admin Email Address
# Only this email address will be recognized and granted the 'admin' role in the platform:
ADMIN_EMAIL=admin@risingroots.com

# Dedicated Application Email & SMTP Delivery Configuration
# Used by the whole application to send automated emails (Welcome, KYC status, Query alerts):
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=risingroots.desk@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx  (Use a 16-character Google App Password)
#   EMAIL_FROM="Rising Roots Trading Desk" <risingroots.desk@gmail.com>
#
# Example for Custom Domain (Zoho / Hostinger / Google Workspace / Amazon SES):
#   SMTP_HOST=smtp.zoho.in
#   SMTP_PORT=465
#   SMTP_USER=notifications@risingroots.com
#   SMTP_PASS=YourEmailPasswordHere
#   EMAIL_FROM="Rising Roots Desk" <notifications@risingroots.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Rising Roots Trading Desk" <notifications@risingroots.com>

# Public Production URL of the Application (used in email call-to-action buttons)
APP_URL=https://rising-roots.onrender.com

# Optional: Telegram VIP Signal Bot Token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHANNEL_ID=@your_vip_channel

# Optional: Payment Gateway (Stripe or Crypto)
# STRIPE_SECRET_KEY=sk_live_...
